terraform {
  backend "s3" {
    region         = "{{ region }}"
    bucket         = "{{ bucket }}"
    key            = "{{ key }}"
    dynamodb_table = "{{ dynamodb_table }}"
    kms_key_id     = "{{ kms_key_id }}"
    encrypt        = true
    role_arn       = "{{ aft_admin_role_arn }}"
  }
}

# Default provider — used by asset_inventory, sensor_management, agentless_scanning_roles
# (IAM/global resources; region is the CT home region which equals var.regions[0])
provider "aws" {
  region = "{{ provider_region }}"
  assume_role {
    role_arn = "{{ target_admin_role_arn }}"
  }
}

# ---------------------------------------------------------------------------
# Regional provider aliases
# Only declare aliases for regions in var.regions. Terraform initializes ALL
# declared provider aliases at startup (even for count=0 modules), so aliases
# for opt-in regions not enabled in the account will cause 403 AssumeRole errors.
#
# To add a region:
#   1. Uncomment the provider alias below
#   2. Uncomment the corresponding module block(s) in main.tf
#   3. Add the region to var.regions in aft.auto.tfvars
# ---------------------------------------------------------------------------

provider "aws" {
  alias  = "us_east_1"
  region = "us-east-1"
  assume_role { role_arn = "{{ target_admin_role_arn }}" }
}

